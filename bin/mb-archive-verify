#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/util.sh"
set_log_context archive-verify verify

usage() {
  cat <<'EOF'
Verify a provider-backup restore using retained archive and destination evidence:
  mb-migrator archive-verify --destination=USER@TARGET \
    --target-root=/srv/htdocs --archive-sha256=HEX --run-id=UUID \
    --expected-url=https://destination.example [options]
  --destination-port=22 --destination-identity=PATH
  --destination-known-hosts=PATH --json

This route does not claim live-source equivalence. It verifies the immutable
archive, migrated file bytes, WordPress state, URL rewrite, safety and rollback.
EOF
}

destination=""; target_root=""; archive_sha=""; run_id=""; expected_url=""
destination_port=22; destination_identity=""; destination_known_hosts=""; json=no
while [[ $# -gt 0 ]]; do
  case "$1" in
    --destination=*) destination="${1#*=}" ;;
    --target-root=*) target_root="${1#*=}" ;;
    --archive-sha256=*) archive_sha="${1#*=}" ;;
    --run-id=*) run_id="${1#*=}" ;;
    --expected-url=*) expected_url="${1#*=}" ;;
    --destination-port=*) destination_port="${1#*=}" ;;
    --destination-identity=*) destination_identity="${1#*=}" ;;
    --destination-known-hosts=*) destination_known_hosts="${1#*=}" ;;
    --json) json=yes ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown archive verification option" ;;
  esac
  shift
done
[[ "$destination" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$ ]] || die "Expected USER@HOST destination"
[[ "$target_root" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "Target root is invalid"
[[ "$archive_sha" =~ ^[a-f0-9]{64}$ ]] || die "Archive SHA-256 is required"
[[ "$run_id" =~ ^[a-fA-F0-9-]{36}$ ]] || die "Migration run UUID is required"
[[ "$expected_url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/.*)?$ ]] || die "Expected URL is invalid"
[[ "$destination_port" =~ ^[0-9]+$ && "$destination_port" -gt 0 && "$destination_port" -le 65535 ]] || die "Destination port is invalid"
for path in "$destination_identity" "$destination_known_hosts"; do [[ -z "$path" || ( -f "$path" && ! -L "$path" ) ]] || die "Destination SSH material is unavailable"; done
dest_ssh=(-p "$destination_port" -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=8)
[[ -z "$destination_identity" ]] || dest_ssh+=(-i "$destination_identity" -o IdentitiesOnly=yes -o IdentityAgent=none)
[[ -z "$destination_known_hosts" ]] || dest_ssh+=(-o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$destination_known_hosts")
if command -v sha256sum >/dev/null 2>&1; then hash=(sha256sum); else hash=(shasum -a 256); fi
id="$(printf '%s' "$archive_sha|$destination|$destination_port|$target_root" | "${hash[@]}" | cut -c1-20)"
remote="$(ssh "${dest_ssh[@]}" "$destination" "cd \"\$HOME/.local/state/mb-migrator/archive-relay/$id\" 2>/dev/null && pwd -P")" || remote=""
[[ "$remote" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "Retained archive restore state is unavailable"
rollback_dir="$(ssh "${dest_ssh[@]}" "$destination" "cat '$remote/current-rollback' 2>/dev/null")" || rollback_dir=""
case "$rollback_dir" in "$remote"/rollback-[A-Za-z0-9._-]*) ;; *) rollback_dir="" ;; esac
safety_sha256="$("${hash[@]}" "$ROOT_DIR/lib/migration-safety.php" | awk '{print $1}')"
output="$(ssh "${dest_ssh[@]}" "$destination" bash -s -- "$remote" "$target_root" "$archive_sha" "$expected_url" "$rollback_dir" "$safety_sha256" < "$ROOT_DIR/lib/remote-archive-verification.sh" 2>/dev/null)" || die "Destination archive verification failed"
value_for() { printf '%s\n' "$output" | awk -F= -v key="$1" '$1 == key {sub(/^[^=]*=/, ""); print; exit}'; }
archive_check="$(value_for archive)"; files_check="$(value_for files)"; wordpress_check="$(value_for wordpress)"
urls_check="$(value_for urls)"; administrator_check="$(value_for administrator)"; serialized_urls_check="$(value_for serialized_urls)"
safety_check="$(value_for safety)"; rollback_check="$(value_for rollback)"; public_https_check=no
content_count="$(value_for content_count)"; media_count="$(value_for media_count)"; migrated_files_count="$(value_for migrated_files_count)"
http_status=0
if command -v curl >/dev/null 2>&1; then http_status="$(curl --proto '=https' --tlsv1.2 -L -sS -o /dev/null -w '%{http_code}' --max-time 30 "$expected_url" 2>/dev/null || true)"; [[ "$http_status" =~ ^[23][0-9][0-9]$ ]] && public_https_check=yes; fi
[[ "$http_status" =~ ^[0-9]{3}$ ]] || http_status=0
status=verified; reason=""
for check in "$archive_check" "$files_check" "$wordpress_check" "$urls_check" "$administrator_check" "$serialized_urls_check" "$safety_check" "$rollback_check" "$public_https_check"; do
  if [[ "$check" != yes ]]; then status=failed; reason=migration.destination_verification_failed; break; fi
done
bool_json() { [[ "$1" == yes ]] && printf true || printf false; }
if [[ "$json" == yes ]]; then
  printf '{"schema_version":1,"tool_version":"%s","run_id":"%s","verification_basis":"immutable_provider_archive","status":"%s","reason_code":%s,"verified_at":"%s","checks":{' "$(<"$ROOT_DIR/VERSION")" "$run_id" "$status" "$([[ -z "$reason" ]] && printf null || printf '"%s"' "$reason")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '"archive":%s,"files":%s,"wordpress":%s,"urls":%s,"administrator":%s,"serialized_urls":%s,"safety":%s,"rollback":%s,"public_https":%s},' "$(bool_json "$archive_check")" "$(bool_json "$files_check")" "$(bool_json "$wordpress_check")" "$(bool_json "$urls_check")" "$(bool_json "$administrator_check")" "$(bool_json "$serialized_urls_check")" "$(bool_json "$safety_check")" "$(bool_json "$rollback_check")" "$(bool_json "$public_https_check")"
  printf '"evidence":{"archive_sha256":"%s","migrated_files_count":%s,"content_count":%s,"media_count":%s,"http_status":%s}}\n' "$archive_sha" "${migrated_files_count:-0}" "${content_count:-0}" "${media_count:-0}" "$http_status"
else
  [[ "$status" == verified ]] && log "Archive destination verification passed" || warn "Archive destination verification failed"
fi
[[ "$status" == verified ]]
