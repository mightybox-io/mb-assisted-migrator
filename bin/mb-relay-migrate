#!/usr/bin/env bash
set -euo pipefail
umask 077
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/util.sh"
source "$ROOT_DIR/lib/provider-profile.sh"
set_log_context relay setup
usage() {
  cat <<'EOF'
Intermediary migration (run on a machine that can SSH to both hosts):
  mb-migrator relay USER@SOURCE --destination=USER@TARGET \
    --source-root=/sites/example --target-root=/srv/htdocs [options]
  --source-port=22 --destination-port=22
  --source-identity=PATH --destination-identity=PATH
  --source-known-hosts=PATH --destination-known-hosts=PATH
  --source-db-method=auto|wp-cli|native
  --normalization-profile=none|wp-engine-v1
  --state-dir=PATH           Private local cache, reused on subsequent catch-ups
  --recover-stale-lock       Recover only a proven dead same-host relay owner
Restore options, including --db-import, --new-url, --safety and --yes, are
forwarded to the destination. Destination cleanup is disabled to retain the
incremental cache. SSH credentials stay on the intermediary. No host connects
to the other host. A fresh full database is imported on every successful run.
EOF
}
if [[ "${1:-}" == --help || $# -eq 0 ]]; then usage; exit 0; fi
source_host="$1"; shift
destination=""; source_root=""; target_root=""; source_port=22; destination_port=22
source_identity=""; destination_identity=""; source_known_hosts=""; destination_known_hosts=""; method=auto
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mb-migrator/relay"
recover_stale_lock=no
normalization_profile=none
restore_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --destination=*) destination="${1#*=}" ;;
    --source-root=*) source_root="${1#*=}" ;;
    --target-root=*) target_root="${1#*=}" ;;
    --source-port=*) source_port="${1#*=}" ;;
    --destination-port=*) destination_port="${1#*=}" ;;
    --source-identity=*) source_identity="${1#*=}" ;;
    --destination-identity=*) destination_identity="${1#*=}" ;;
    --source-known-hosts=*) source_known_hosts="${1#*=}" ;;
    --destination-known-hosts=*) destination_known_hosts="${1#*=}" ;;
    --source-db-method=*) method="${1#*=}" ;;
    --normalization-profile=*) normalization_profile="${1#*=}" ;;
    --state-dir=*) state_dir="${1#*=}" ;;
    --recover-stale-lock) recover_stale_lock=yes ;;
    --rollback-dir=*) die "Relay owns its private rollback location" ;;
    --cleanup=*|--delete-stage-after-success|--delete-archive-after-success|--delete-sql-after-import)
      die "Relay retains its cache; remove private state separately after cutover" ;;
    --dry-run) die "Relay collects a fresh snapshot; use doctor for a non-mutating preflight" ;;
    *) restore_args+=("$1") ;;
  esac
  shift
done
for host in "$source_host" "$destination"; do
  [[ "$host" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$ ]] || die "Expected USER@HOST for both SSH endpoints"
done
for path in "$source_root" "$target_root"; do
  [[ "$path" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "Both document roots must be absolute paths without shell characters"
done
for port in "$source_port" "$destination_port"; do
  [[ "$port" =~ ^[0-9]+$ && "$port" -gt 0 && "$port" -le 65535 ]] || die "Invalid SSH port"
done
case "$method" in auto|wp-cli|native) ;; *) die "Invalid source database method" ;; esac
normalization_profile_validate "$normalization_profile" || die "Invalid normalization profile"
for path in "$source_identity" "$destination_identity" "$source_known_hosts" "$destination_known_hosts"; do
  [[ -z "$path" || ( -f "$path" && ! -L "$path" ) ]] || die "A required SSH identity or known-hosts file is unavailable"
done
need_cmd ssh; need_cmd rsync; need_cmd tar
value_for() { printf '%s\n' "$1" | awk -F= -v key="$2" '$1 == key {sub(/^[^=]*=/, ""); print; exit}'; }
source_ssh=(-p "$source_port" -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=8)
dest_ssh=(-p "$destination_port" -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=8)
[[ -z "$source_identity" ]] || source_ssh+=(-i "$source_identity" -o IdentitiesOnly=yes -o IdentityAgent=none)
[[ -z "$destination_identity" ]] || dest_ssh+=(-i "$destination_identity" -o IdentitiesOnly=yes -o IdentityAgent=none)
[[ -z "$source_known_hosts" ]] || source_ssh+=(-o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$source_known_hosts")
[[ -z "$destination_known_hosts" ]] || dest_ssh+=(-o StrictHostKeyChecking=yes -o "UserKnownHostsFile=$destination_known_hosts")
if command -v sha256sum >/dev/null 2>&1; then hash=(sha256sum); else hash=(shasum -a 256); fi
id="$(printf '%s' "$source_host|$source_port|$source_root|$destination|$destination_port|$target_root" | "${hash[@]}" | cut -c1-20)"
mkdir -p "$state_dir"; state_dir="$(cd "$state_dir" && pwd -P)"
work="$state_dir/$id"
mkdir -p "$work/package/htdocs/wp-content" "$work/package/database-package"
chmod 700 "$state_dir" "$work" "$work/package" "$work/package/htdocs" "$work/package/database-package"
lock_dir="$work/lock"
lock_owner="$lock_dir/owner"
lock_host="$(uname -n)"
lock_retain=no
[[ "$lock_host" =~ ^[A-Za-z0-9._-]+$ ]] || die "Local hostname is unsafe for relay lock ownership"
if ! mkdir "$lock_dir" 2>/dev/null; then
  [[ "$recover_stale_lock" == yes ]] || die "Relay cache is locked; check for a running migration or use --recover-stale-lock after proving the owner stopped"
  [[ -f "$lock_owner" && ! -L "$lock_owner" ]] || die "Relay lock ownership is missing or unsafe; inspect it manually"
  owner_host="$(awk -F= '$1 == "host" { print $2; exit }' "$lock_owner")"
  owner_pid="$(awk -F= '$1 == "pid" { print $2; exit }' "$lock_owner")"
  owner_phase="$(awk -F= '$1 == "phase" { print $2; exit }' "$lock_owner")"
  [[ "$owner_host" == "$lock_host" && "$owner_pid" =~ ^[0-9]+$ && "$owner_pid" -gt 1 ]] || \
    die "Relay lock ownership is foreign or malformed; inspect it manually"
  case "$owner_phase" in
    setup|preflight|files|database|transfer) ;;
    restore|complete) die "Relay lock stopped during or after destination restore; reconcile the destination and rollback point manually" ;;
    *) die "Relay lock phase is missing or unknown; inspect it manually" ;;
  esac
  if kill -0 "$owner_pid" 2>/dev/null; then
    die "Relay cache is owned by active PID $owner_pid on this host"
  fi
  rm -f "$lock_owner"
  rmdir "$lock_dir" 2>/dev/null || die "Relay lock changed during recovery; retry after inspecting the cache"
  mkdir "$lock_dir" 2>/dev/null || die "Another relay acquired the cache during recovery"
  warn "Recovered relay lock from dead PID $owner_pid on this host"
fi
chmod 700 "$lock_dir"
write_lock_owner() {
  local phase="$1" temporary="$lock_owner.tmp.$$"
  printf 'host=%s\npid=%s\nphase=%s\n' "$lock_host" "$$" "$phase" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$lock_owner"
}
write_lock_owner setup
cleanup_lock() {
  if [[ "$lock_retain" == yes ]]; then
    warn "Relay lock retained because destination restore or rollback readiness is ambiguous: $lock_dir"
    return 0
  fi
  [[ -f "$lock_owner" && ! -L "$lock_owner" ]] || return 0
  grep -Fxq "host=$lock_host" "$lock_owner" || return 0
  grep -Fxq "pid=$$" "$lock_owner" || return 0
  rm -f "$lock_owner"
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup_lock EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
relay_phase() {
  set_log_phase "$1"
  write_lock_owner "$1"
}
log "Private relay cache: $work"
relay_phase preflight
mapfile -t normalization_args < <(normalization_profile_remote_args "$normalization_profile")
source_preflight_output="$(ssh "${source_ssh[@]}" "$source_host" bash -s -- preflight "$source_root" "$method" "${normalization_args[@]}" < "$ROOT_DIR/lib/remote-source.sh")"
printf '%s\n' "$source_preflight_output"
normalization_rule_ids="$(value_for "$source_preflight_output" normalization_rule_ids)"
normalization_unknown_count="$(value_for "$source_preflight_output" normalization_unknown_count)"
[[ "$normalization_unknown_count" =~ ^[0-9]+$ ]] || die "Invalid normalization preview"
normalization_report="$work/package/mb-migrator-normalization-v1"
{
  printf 'schema_version=1\nprofile_id=%s\nunknown_components_count=%s\n' "$normalization_profile" "$normalization_unknown_count"
  IFS=',' read -r -a present_rule_ids <<< "$normalization_rule_ids"
  for rule_id in "${present_rule_ids[@]}"; do
    [[ -n "$rule_id" ]] || continue
    normalization_profile_has_rule "$normalization_profile" "$rule_id" || die "Source returned an unknown normalization rule"
    printf 'rule=%s|excluded\n' "$rule_id"
  done
} > "$normalization_report"
chmod 600 "$normalization_report"
if [[ "$normalization_unknown_count" -gt 0 ]]; then
  warn "$normalization_unknown_count unclassified source MU-plugin component(s) will remain excluded by the migration policy"
fi
remote="$(ssh "${dest_ssh[@]}" "$destination" "umask 077; mkdir -p \"\$HOME/.local/state/mb-migrator/relay/$id\" && cd \"\$HOME/.local/state/mb-migrator/relay/$id\" && pwd -P")"
[[ "$remote" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "Destination returned an unsupported staging path"
ssh "${dest_ssh[@]}" "$destination" "command -v rsync >/dev/null && test -d '$target_root/wp-content' && mkdir -p '$remote/package' '$remote/runner'"
rollback_token="$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM:-0}"
[[ "$rollback_token" =~ ^[A-Za-z0-9._-]+$ ]] || die "Could not create a safe rollback identity"
rollback_dir="$remote/rollback-$rollback_token"
printf -v source_transport 'ssh'; for arg in "${source_ssh[@]}"; do printf -v source_transport '%s %q' "$source_transport" "$arg"; done
printf -v dest_transport 'ssh'; for arg in "${dest_ssh[@]}"; do printf -v dest_transport '%s %q' "$dest_transport" "$arg"; done
relay_phase files
profile_excludes=()
while IFS= read -r exclude_path; do
  [[ -n "$exclude_path" ]] || continue
  profile_excludes+=("--exclude=$exclude_path")
done < <(normalization_profile_rsync_excludes "$normalization_profile")
rsync -az --checksum --safe-links --partial --no-perms --no-owner --no-group -e "$source_transport" \
  "${profile_excludes[@]}" \
  --include='/plugins/***' --include='/themes/***' --include='/uploads/***' --include='/mu-plugins/***' --exclude='*' \
  "$source_host:$source_root/wp-content/" "$work/package/htdocs/wp-content/"
ssh "${source_ssh[@]}" "$source_host" bash -s -- archive-root "$source_root" "$method" < "$ROOT_DIR/lib/remote-source.sh" > "$work/root.tar.gz"
tar -xzf "$work/root.tar.gz" -C "$work/package/htdocs"
relay_phase database
ssh "${source_ssh[@]}" "$source_host" bash -s -- export-db "$source_root" "$method" < "$ROOT_DIR/lib/remote-source.sh" > "$work/package/database-package/site.sql.tmp"
[[ -s "$work/package/database-package/site.sql.tmp" ]] || die "Empty database export"
mv "$work/package/database-package/site.sql.tmp" "$work/package/database-package/site.sql"
source_url="$(ssh "${source_ssh[@]}" "$source_host" bash -s -- get-url "$source_root" "$method" < "$ROOT_DIR/lib/remote-source.sh")" || die "Source URL lookup failed; retained cache: $work"
[[ "$source_url" =~ ^https?://[^[:space:]]+$ ]] || die "Source URL unavailable; export a portable package instead"
printf 'format=mb-wordpress-package-v1\nsource_url=%s\ncreated_utc=%s\n' "$source_url" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$work/package/mb-wordpress-package-manifest"
relay_phase transfer
rsync -az --checksum --safe-links --partial --no-owner --no-group -e "$dest_transport" "$work/package/" "$destination:$remote/package/"
# Verify every transferred byte against the collected cache before importing.
comparison="$(rsync -rlcn --safe-links --out-format='%n' -e "$dest_transport" "$work/package/" "$destination:$remote/package/")"
[[ -z "$comparison" ]] || die "Relay checksum verification failed; rerun to repair the retained cache"
tar -czf "$work/runner.tar.gz" -C "$ROOT_DIR" bin lib providers
a="$(printf '%q' "$remote/runner")"
ssh "${dest_ssh[@]}" "$destination" "tar -xzf - -C $a" < "$work/runner.tar.gz"
printf -v import_command 'bash %q import-staged %q --target-root=%q --cleanup=no --rollback-dir=%q' \
  "$remote/runner/bin/mb-migrator" "$remote/package" "$target_root" "$rollback_dir"
if [[ "${#restore_args[@]}" -gt 0 ]]; then
  for arg in "${restore_args[@]}"; do printf -v import_command '%s %q' "$import_command" "$arg"; done
fi
lock_retain=yes
relay_phase restore
printf -v login_command 'bash -lc %q' "$import_command"
ssh "${dest_ssh[@]}" "$destination" "$login_command"
printf -v rollback_marker_command 'umask 077; printf "%%s\\n" %q > %q' "$rollback_dir" "$remote/current-rollback"
ssh "${dest_ssh[@]}" "$destination" "$rollback_marker_command" || \
  die "Migration imported, but rollback readiness could not be recorded"
relay_phase complete
lock_retain=no
log "Relay migration completed. Rerun the same command for checksum-based catch-up."
