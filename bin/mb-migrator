#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
export MB_MIGRATOR_PROG_NAME="mb-migrator"

case "${1:-}" in
  --version|-V)
    printf 'mb-migrator %s\n' "$(<"$ROOT_DIR/VERSION")"
    exit 0
    ;;
  --help|-h|'')
    "$SCRIPT_DIR/mb-live-migrate" --help
    printf '\n'
    "$SCRIPT_DIR/mb-package" --help
    printf '\n'
    "$SCRIPT_DIR/mb-push-migrate" --help
    "$SCRIPT_DIR/mb-relay-migrate" --help
    "$SCRIPT_DIR/mb-relay-verify" --help
    "$SCRIPT_DIR/mb-archive-relay" --help
    "$SCRIPT_DIR/mb-archive-verify" --help
    "$SCRIPT_DIR/mb-migration-state" --help
    printf '\nArchive restore options:\n\n'
    exec "$SCRIPT_DIR/wp-export-migrate" --help
    ;;
  relay)
    shift
    exec "$SCRIPT_DIR/mb-relay-migrate" "$@"
    ;;
  relay-doctor)
    shift
    exec "$SCRIPT_DIR/mb-relay-doctor" "$@"
    ;;
  relay-verify)
    shift
    exec "$SCRIPT_DIR/mb-relay-verify" "$@"
    ;;
  archive-relay)
    shift
    exec "$SCRIPT_DIR/mb-archive-relay" "$@"
    ;;
  archive-verify)
    shift
    exec "$SCRIPT_DIR/mb-archive-verify" "$@"
    ;;
  safety|rollback)
    exec "$SCRIPT_DIR/mb-migration-state" "$@"
    ;;
  push|push-pair|push-site)
    exec "$SCRIPT_DIR/mb-push-migrate" "$@"
    ;;
  export-site|import-site|import-staged)
    exec "$SCRIPT_DIR/mb-package" "$@"
    ;;
  pair|pull)
    exec "$SCRIPT_DIR/mb-live-migrate" "$@"
    ;;
  doctor)
    case " $* " in
      *" --source="*) exec "$SCRIPT_DIR/mb-live-migrate" "$@" ;;
    esac
    ;;
esac

exec "$SCRIPT_DIR/wp-export-migrate" "$@"
